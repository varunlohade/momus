# Copy to .env and fill in. Never commit .env.

# Slack bot token (xoxb-...). Scopes: see docs/SETUP.md.
SLACK_BOT_TOKEN=
# Home channel for triage and alerts (name without #, or an id).
SLACK_CHANNEL=momus
# Channel where the team logs tickets, one message per ticket.
TICKETS_CHANNEL=tickets
# Extra reaction names that mean "done", comma-separated (optional).
TICKET_DONE_REACTIONS=

# Zendesk (read-only). Leave empty to skip the support scripts.
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
# Regex source matching your support bot's canned replies (optional).
SUPPORT_BOT_PATTERN=
# Hours from UTC for "yesterday" in the daily report (5.5 = IST).
REPORT_UTC_OFFSET=0

# Surge thresholds (optional; defaults shown).
SURGE_WINDOW_MIN=120
SURGE_DISTINCT_USERS=5
SURGE_VOLUME_MULT=3
SURGE_COOLDOWN_MIN=360

# App Store Connect API key (optional). Leave empty to skip iOS.
ASC_APP_ID=
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8
# Google Play package name (optional). Leave empty to skip Android.
PLAY_PACKAGE=

# Where state files go (optional; default ./data).
MOMUS_DATA_DIR=
